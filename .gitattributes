# Line-ending policy — keep the repo consistent across Windows / WSL / CI
#
# Default: normalize to LF in the repo. Every type we actually build or run gets
# an explicit `eol=` entry, because `text=auto` alone leaves the checkout-side
# line ending to core.autocrlf and the editor, which is how CRLF .sh files reach
# Linux and fail with `bad interpreter: /usr/bin/env bash^M`.
* text=auto eol=lf

# --- Shell scripts: LF is mandatory ---------------------------------------
*.sh        text eol=lf
*.bash      text eol=lf
gradlew     text eol=lf
*.gradlew   text eol=lf

# --- Windows batch / PowerShell: CRLF is mandatory -----------------------
# Do NOT force eol=lf on these. cmd.exe mis-parses LF-only batch files:
# `goto :label` fails with "The system cannot find the batch label specified".
# gradlew.bat uses goto, so LF here breaks the Windows build outright.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# --- Source & build config: LF -------------------------------------------
*.kt        text eol=lf
*.kts       text eol=lf
*.java      text eol=lf
*.gradle    text eol=lf
*.properties text eol=lf
*.pro       text eol=lf

# --- Data / docs / CI: LF ------------------------------------------------
*.md        text eol=lf
*.txt       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.drawio    text eol=lf
*.py        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf

# Binary files — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.keystore binary
*.jks  binary
*.apk  binary
*.aab  binary
*.so   binary
*.jar  binary
*.aar  binary
*.zip  binary
*.mp3  binary
*.mp4  binary
