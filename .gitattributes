# Line-ending policy — keep the repo consistent across Windows/WSL/CI
* text=auto

# Scripts & build files: LF (Unix) — safe on Windows and WSL, no CRLF churn
*.bat    text eol=lf
*.ps1    text eol=lf
*.sh     text eol=lf
*.gradle text eol=lf
*.kts    text eol=lf
*.properties text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.json   text eol=lf
*.xml    text eol=lf

# Binary files — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.keystore binary
*.apk  binary
*.aab  binary
*.so   binary
*.jar  binary
*.aar  binary
